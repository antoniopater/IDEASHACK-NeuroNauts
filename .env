# Domyślnie lokalna baza JSON (bez Supabase).
# Wyłącz: USE_LOCAL_JSON_DB=false w .env.local (ma pierwszeństwo).
USE_LOCAL_JSON_DB=true

# Model AI (wybierany automatycznie — pierwszy dopasowany backend):
# 1) GROQ_API_KEY → Groq (szybkie, darmowy limit: https://console.groq.com)
#    opcjonalnie: GROQ_MODEL=llama-3.3-70b-versatile
# 2) ANTHROPIC_API_KEY → Claude (dotychczasowe)
# 3) OPENAI_BASE_URL + OPENAI_API_KEY + OPENAI_MODEL → każde API kompatybilne z OpenAI (OpenRouter, proxy)
# Wymuszony backend: AI_PROVIDER=groq | anthropic | openai_compatible
