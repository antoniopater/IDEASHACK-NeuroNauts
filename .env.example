# Local JSON database by default (without Supabase).
# Disable with USE_LOCAL_JSON_DB=false if you want to use Supabase.
USE_LOCAL_JSON_DB=true

# LLM provider (use ONE option below):
# 1) Groq (recommended for hackathons)
GROQ_API_KEY=your_groq_api_key_here
# optional:
# GROQ_MODEL=llama-3.3-70b-versatile

# 2) Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# optional:
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 3) OpenAI-compatible API
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_compatible_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional: force backend selection
# AI_PROVIDER=groq

# Supabase (required only when USE_LOCAL_JSON_DB=false)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
