# Local JSON database by default (without Supabase).
# Disable with USE_LOCAL_JSON_DB=false if you want to use Supabase.
USE_LOCAL_JSON_DB=true

# Podpis ciasteczka sesji (rdbridge_session). W produkcji WYMAGANE.
# Lokalnie: możesz pominąć — serwer dev wygeneruje losowy sekret na start (sesje resetują się po restarcie).
# openssl rand -base64 32
# AUTH_SESSION_SECRET=
# LLM provider (wystarczy JEDNA z opcji poniżej):
# 1) Groq (polecane na hackathon)
GROQ_API_KEY=your_groq_api_key_here
# optional:
# GROQ_MODEL=llama-3.3-70b-versatile

# 2) Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# optional:
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 3) OpenAI-compatible API
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_compatible_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Opcjonalnie: wymuszony backend LLM (Groq ma pierwszeństwo przy auto jeśli oba klucze)
# AI_PROVIDER=groq | anthropic | openai_compatible

#
# ─── Embeddingi (semantic matching) ─────────────────────────────────────────
# Routing domyślnie podąża za tym samym backendem LLM co resolveLlmBackend():
# • Groq  → https://api.groq.com/openai/v1/embeddings (Ten sam co chat: GROQ_API_KEY)
# • OpenAI-compatible → OPENAI_BASE_URL/embeddings lub api.openai.com
# • Anthropic → Anthropic nie ma własnych embeddingów; ustaw VOYAGE_API_KEY (rekomendowane
#     przez dokumentację Claude) lub OPENAI_API_KEY wyłącznie na embeddingi.
#
# Wymuszenie innego dostawcy niż przy LLM (np. LLM Groq, embeddy OpenAI):
# EMBEDDING_PROVIDER=auto | groq | openai | voyage
#
# Ważne przy czacie przez Groq: nie zostawiaj w .env / .env.local WYPEŁNIONEGO
# OPENAI_EMBEDDINGS_API_KEY ani OPENAI_EMBEDDINGS_URL=api.openai.com, jeśli nie masz
# prawdziwego klucza OpenAI — aplikacja mogłaby wysyłać żądania na OpenAI z błędnym
# kluczem i zwracać „Invalid API Key”. Przy auto + Groq te zmienne są wtedy ignorowane
# (embeddy idą na Groq). Aby wymusić OpenAI podczas czatu na Groq:
# EMBEDDING_PROVIDER=openai + prawdziwy OPENAI_EMBEDDINGS_API_KEY lub OPENAI_API_KEY.

# Groq — model embeddingu jeśli na liście GET https://api.groq.com/openai/v1/models pojawia się id z fragmentem „embed”.
# Bez jawnego ustawienia aplikacja wybiera automatycznie z tej listy; na wielu kontach lista nie zawiera embeddingów —
# wtedy ranking zostanie heurystyczny; semantyczne embeddy można dać przez OpenAI-compat (np. lokalnie Ollama):
# OPENAI_EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1 + OPENAI_EMBEDDING_MODEL=<model> + EMBEDDING_PROVIDER=openai
# Opcjonalnie wymuszony id (również wariant z _: `nomic-embed-text-v1_5`, nie sam `…v1.5`).
# GROQ_EMBEDDING_MODEL=nomic-embed-text-v1_5

# Voyage AI (Anthropic-friendly, format jak OpenAI /v1/embeddings)
# VOYAGE_API_KEY=
# VOYAGE_EMBEDDING_MODEL=voyage-3-large

# Hard override OpenAI-shape (proxy, osobne konto, OpenRouter embeddings itd.)
# OPENAI_EMBEDDINGS_API_KEY=
# OPENAI_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Wagi łączenia wyników (opcjonalnie, liczby dziesiętne):
# MATCH_RANK_HEURISTIC_WEIGHT=0.38
# MATCH_RANK_SEMANTIC_WEIGHT=0.62
# Maks. liczba briefów ocenianych embeddingiem (po prefiltrze heurystyki): MATCH_SEMANTIC_POOL_SIZE=48
# MATCH_APPLY_LLM_WEIGHT=0.42
# MATCH_APPLY_EMBED_WEIGHT=0.58
# Mapowanie cosinus → 0–100: MATCH_EMBED_COSINE_LO=0.42  MATCH_EMBED_COSINE_HI=0.90

# Supabase (required only when USE_LOCAL_JSON_DB=false)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
